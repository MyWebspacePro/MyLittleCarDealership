# ── Datenbank (lokal) ────────────────────────────────────────
POSTGRES_USER=mld
POSTGRES_PASSWORD=mld
POSTGRES_DB=mld
DATABASE_URL=postgresql://mld:mld@localhost:5432/mld

# ── API ──────────────────────────────────────────────────────
API_PORT=3001
# Erlaubte Browser-Origins für CORS, kommagetrennt.
CORS_ORIGINS=http://localhost:5173

# Im Produktivbetrieb zwingend ändern (z. B. openssl rand -hex 32).
JWT_SECRET=dev-secret-change-me-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-too
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ── Mail (lokal: Mailhog auf Port 1025) ──────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MyLittleCarDealership <noreply@example.ch>