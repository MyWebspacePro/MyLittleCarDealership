# Produktions-Vorlage für den VPS.
# deploy.sh kopiert diese Datei nach .env und ersetzt die Platzhalter durch
# zufällige Geheimnisse. APP_DOMAIN muss auf die eigene Domain zeigen.
APP_DOMAIN=deine-domain.ch

POSTGRES_USER=mld
POSTGRES_PASSWORD=HIER-STARKES-PASSWORT
POSTGRES_DB=mld
DATABASE_URL=postgresql://mld:HIER-STARKES-PASSWORT@db:5432/mld

API_PORT=3001
CORS_ORIGINS=https://deine-domain.ch

JWT_SECRET=HIER-MIT-OPENSSL-RAND-HEX-32-ERZEUGEN
JWT_REFRESH_SECRET=HIER-MIT-OPENSSL-RAND-HEX-32-ERZEUGEN
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MyLittleCarDealership <noreply@deine-domain.ch>